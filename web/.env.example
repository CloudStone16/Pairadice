# PairADice web - environment variable NAMES only. Never commit real values.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Normal development: `bun run dev:kc` reads every PD_DB_* login and AUTH_SECRET from the macOS Keychain
# (account "pairadice", services pairadice/pd_web, pd_auth, pd_api, pd_mod, pd_admin, auth_secret) and
# starts the dev server. `bun run check:db` does the same and proves each login's privileges.
# Fallback (development only, and only with PAIRADICE_DEV_DB_FALLBACK=1): the "web" login uses
# MYSQL_USER / MYSQL_PWD, or root when MYSQL_USER is empty. Production never falls back.
PAIRADICE_DEV_DB_FALLBACK=
MYSQL_USER=
# Export the password in the shell, never write it to a file.
MYSQL_PWD=
# Optional: path to the MySQL socket, for a passwordless auth_socket login.
# When set, MYSQL_HOST, MYSQL_PORT and MYSQL_PWD are ignored.
MYSQL_SOCKET=
MYSQL_DATABASE=pairadice

# Per-role MySQL logins. With MYSQL_SOCKET set, passwords are ignored.
# Anonymous reads (pairadice_web_ro): no message, friendship, user_block or recommendations.
PD_DB_USER_WEB=
# Sign-in/sign-up/session login (pairadice_auth).
PD_DB_USER_AUTH=
# Reads and writes by a signed-in player (pairadice_player).
PD_DB_USER_PLAYER=
# Reads and writes by a moderator (pairadice_moderator).
PD_DB_USER_MODERATOR=
# Reads and writes by an admin (pairadice_admin).
PD_DB_USER_ADMIN=
# Passwords per login (TCP only); export in the shell, never write real values here.
PD_DB_PWD_WEB=
PD_DB_PWD_AUTH=
PD_DB_PWD_PLAYER=
PD_DB_PWD_MODERATOR=
PD_DB_PWD_ADMIN=
# HMAC key for session tokens, at least 32 bytes (openssl rand -base64 48). Required in production.
AUTH_SECRET=

# Set to 1 (development only) to keep the dev "play as" switch; a real session cookie wins.
PAIRADICE_DEV_AUTH=
# Discord login stays off until a Discord app is supplied.
PAIRADICE_DISCORD_LOGIN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Production only: public https origin of the site, used to build the Discord redirect URI (login stays off without it).
PAIRADICE_PUBLIC_URL=

# MongoDB vector store (read-only from the web app). MONGO_URI is required in production (never logged);
# development falls back to a local instance.
MONGO_URI=
MONGO_DB=
