# PairADice web - environment variable NAMES only. Never commit real values.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Development: the read-only login created by `database/setup.sh --web-user`.
# (root works locally but logs a warning; production refuses root.)
MYSQL_USER=pairadice_web_ro
# The password must be exported in the shell, never written to a file:
#   PAIRADICE_DEV_AUTH=1 MYSQL_PWD=... bun run dev
MYSQL_PWD=
# Optional: path to the MySQL socket, for a passwordless auth_socket login.
# When set, MYSQL_HOST, MYSQL_PORT and MYSQL_PWD are ignored.
MYSQL_SOCKET=
MYSQL_DATABASE=pairadice

# Per-role MySQL logins (Phase 2). With MYSQL_SOCKET set, passwords are ignored.
# Web pool login; falls back to MYSQL_USER when empty.
PD_DB_USER_WEB=
# Sign-in/sign-up/session login (pairadice_auth).
PD_DB_USER_AUTH=
# Login for writes by a signed-in player (pairadice_player).
PD_DB_USER_PLAYER=
# Login for moderator writes (pairadice_moderator).
PD_DB_USER_MODERATOR=
# Login for admin pages (pairadice_admin).
PD_DB_USER_ADMIN=
# Passwords per login (TCP only); export in the shell, never write real values here.
PD_DB_PWD_WEB=
PD_DB_PWD_AUTH=
PD_DB_PWD_PLAYER=
PD_DB_PWD_MODERATOR=
PD_DB_PWD_ADMIN=
# HMAC key for session tokens, at least 32 bytes (openssl rand -base64 48). Required in production.
AUTH_SECRET=

# Set to 1 (development only) to keep the dev "play as" switch; a real session cookie wins.
PAIRADICE_DEV_AUTH=
# Discord login stays off until a Discord app is supplied.
PAIRADICE_DISCORD_LOGIN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
