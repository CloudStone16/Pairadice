{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bun run sprites",
    "dev": "next dev --turbopack -H 127.0.0.1",
    "prebuild": "bun run sprites",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sprites": "bun scripts/build-sprites.ts",
    "dev:kc": "scripts/dev-keychain.sh bun run dev",
    "check:db": "scripts/dev-keychain.sh bun scripts/check-db-roles.ts",
    "check:chat": "bun scripts/check-chat-reads.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "mongodb": "^7.8.0",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
