# PairADice web - environment variable NAMES only. Never commit real values.
# Passwords live in the macOS Keychain (account "pairadice", service "pairadice/<key>")
# and are injected by `bun run dev:kc` (scripts/dev-keychain.sh); never write them to a file.

# MySQL host / port / schema
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=

# Per-role MySQL logins (RBAC is enforced by the database). *_USER is optional
# (defaults: pd_web, pd_auth, pd_api, pd_mod, pd_admin).
# Anonymous browsing, read-only
PD_WEB_USER=
PD_WEB_PWD=
# Sign-up / login / session tables only
PD_AUTH_USER=
PD_AUTH_PWD=
# Signed-in players
PD_API_USER=
PD_API_PWD=
# Moderators
PD_MOD_USER=
PD_MOD_PWD=
# Administrators
PD_ADMIN_USER=
PD_ADMIN_PWD=

# Secret used to sign session tokens
AUTH_SECRET=

# Development only: set to 1 to "play as" a seed player via the HUD dev switch
PAIRADICE_DEV_AUTH=

# MongoDB vector store (later phase); user/password come from the Keychain (mongo_api)
MONGO_URI=
